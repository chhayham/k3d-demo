            "metadata": {
              "app_version": "0.1.0",
              "chart": "httproute",
              "first_deployed": 1790097958,
              "last_deployed": 1790097958,
              "name": "monitoring-httproute",
              "namespace": "monitoring",
              "notes": "",
              "revision": 1,
              "values": "{\"httpRoutes\":[{\"hostnames\":[\"monitoring.localhost\"],\"name\":\"kube-prometheus-stack-prometheus-http\",\"namespace\":\"monitoring\",\"parentRefs\":[{\"name\":\"traefik-gateway\",\"namespace\":\"traefik\",\"sectionName\":\"websecure\"}],\"rules\":[{\"backendRefs\":[{\"name\":\"kube-prometheus-stack-prometheus\",\"port\":9090}]}]},{\"hostnames\":[\"grafana.localhost\"],\"name\":\"kube-prometheus-stack-grafana\",\"namespace\":\"monitoring\",\"parentRefs\":[{\"name\":\"traefik-gateway\",\"namespace\":\"traefik\",\"sectionName\":\"websecure\"}],\"rules\":[{\"backendRefs\":[{\"name\":\"kube-prometheus-stack-grafana\",\"port\":80}]}]},{\"hostnames\":[\"alertmanager.localhost\"],\"name\":\"kube-prometheus-stack-alertmanager\",\"namespace\":\"monitoring\",\"parentRefs\":[{\"name\":\"traefik-gateway\",\"namespace\":\"traefik\",\"sectionName\":\"websecure\"}],\"rules\":[{\"backendRefs\":[{\"name\":\"kube-prometheus-stack-alertmanager\",\"port\":9093}]}]},{\"hostnames\":[\"loki.localhost\"],\"name\":\"loki\",\"namespace\":\"monitoring\",\"parentRefs\":[{\"name\":\"traefik-gateway\",\"namespace\":\"traefik\",\"sectionName\":\"websecure\"}],\"rules\":[{\"backendRefs\":[{\"name\":\"loki\",\"port\":3100}]}]}]}",
              "version": "0.2.0"
            },
