            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": false,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "kargo-httproute",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": {
              "app_version": "0.1.0",
              "chart": "httproute",
              "first_deployed": 1790098094,
              "last_deployed": 1790098094,
              "name": "kargo-httproute",
              "namespace": "kargo",
              "notes": "",
              "revision": 1,
              "values": "{\"httpRoutes\":[{\"hostnames\":[\"kargo.localhost\"],\"name\":\"kargo-api-http\",\"namespace\":\"kargo\",\"parentRefs\":[{\"name\":\"traefik-gateway\",\"namespace\":\"traefik\",\"sectionName\":\"websecure\"}],\"rules\":[{\"backendRefs\":[{\"name\":\"kargo-api\",\"port\":80}]}]}]}",
              "version": "0.2.0"
            },
            "name": "kargo-httproute",
            "namespace": "kargo",
            "pass_credentials": false,
            "postrender": null,
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "resources": null,
            "reuse_values": false,
            "set": null,
            "set_list": null,
            "set_sensitive": null,
            "set_wo": null,
            "set_wo_revision": null,
            "skip_crds": false,
            "status": "deployed",
            "take_ownership": false,
            "timeout": 900,
            "timeouts": null,
            "upgrade_install": false,
            "values": [
              "httpRoutes:  \n  - name: kargo-api-http\n    namespace: kargo\n    parentRefs:\n        - name: traefik-gateway # Gateway created by Traefik when the Gateway API provider is enabled\n          sectionName: websecure\n          namespace: traefik\n    hostnames:\n      - \"kargo.localhost\"\n    rules:\n      - backendRefs:\n        - name: kargo-api\n          port: 80"
            ],
            "verify": false,
            "version": "0.2.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
