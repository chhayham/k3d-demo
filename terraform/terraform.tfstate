            "values": [
              "# Enable installation of cert-manager CRDs with the chart\ncrds:\n  enabled: true\n\n# cert-manager configuration\nconfig:\n  # Enable the Gateway API admission controller\n  gatewayAPI:\n    enabled: true\n"
